+#endif
+	SUSFS_LOGI("Initializing susfs_extra_works\n");
+	INIT_WORK(&susfs_extra_works, susfs_run_extra_works);
+	SUSFS_LOGI("susfs is initialized! version: " SUSFS_VERSION " \n");
+}
