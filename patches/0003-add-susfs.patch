From 5118a1716a87234162b0839326f3dc04a1bfeaef Mon Sep 17 00:00:00 2001
From: test <test@test.com>
Date: Thu, 29 Oct 2026 05:10:57 -0400
Subject: [PATCH] guacamoleb: add SUSFS 2.3.0 kernel integration

---
 drivers/Kconfig           |    1 +
 drivers/Makefile          |    2 +
 fs/Makefile               |    2 +
 fs/dcache.c               |   14 +
 fs/namei.c                |  130 +++
 fs/namespace.c            |  292 ++++++-
 fs/notify/fdinfo.c        |   48 ++
 fs/overlayfs/inode.c      |    8 +
 fs/overlayfs/overlayfs.h  |    3 +
 fs/overlayfs/readdir.c    |   12 +
 fs/overlayfs/super.c      |   12 +
 fs/overlayfs/util.c       |   14 +
 fs/proc/cmdline.c         |    9 +
 fs/proc/fd.c              |   17 +
 fs/proc/task_mmu.c        |   16 +
 fs/proc_namespace.c       |   18 +
 fs/readdir.c              |   25 +
 fs/stat.c                 |   18 +
 fs/statfs.c               |   43 +
 fs/sus_su.c               |  140 +++
 fs/susfs.c                | 1714 +++++++++++++++++++++++++++++++++++++
 include/linux/mount.h     |    3 +
 include/linux/sched.h     |    4 +
 include/linux/sus_su.h    |    9 +
 include/linux/susfs.h     |  289 +++++++
 include/linux/susfs_def.h |  123 +++
 kernel/kallsyms.c         |   11 +
 kernel/sys.c              |    6 +
 28 files changed, 2982 insertions(+), 1 deletion(-)
